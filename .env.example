# ─────────────────────────────────────────────────────────────
# ProofRecall — environment variables (EXAMPLE / TEMPLATE ONLY)
# ─────────────────────────────────────────────────────────────
# NEVER commit real secrets. Copy this file to `.env.local` for
# local development and fill in real values there. `.env.local`
# is git-ignored. On Vercel, set these in Project → Settings →
# Environment Variables.
#
# Day 1 note: these are placeholders. No DB calls happen yet.
# You will create the Supabase project on Day 2 (auth wiring).

# ── Supabase (client-safe: exposed to the browser) ───────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server-only secrets (added on later days; keep private) ──
# Supabase service role — bypasses RLS. SERVER ONLY. (Day 3+)
# SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy — payments + webhooks (Day 9-10)
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=

# Resend — transactional email (Day 11)
# RESEND_API_KEY=

# Sentry — error monitoring (Day 14)
# NEXT_PUBLIC_SENTRY_DSN=
